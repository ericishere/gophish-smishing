# Minify client side assets (JavaScript)
FROM node:18-alpine AS build-js

RUN npm install gulp gulp-cli -g

WORKDIR /build
COPY . .
RUN npm install
RUN gulp


# Build Golang binary
# NOTE: must be Alpine too — a binary built on the Debian-based golang image
# links against glibc and won't run on the Alpine runtime.
FROM golang:1.21-alpine AS build-golang

# CGO is required for mattn/go-sqlite3, so we need a C compiler + musl libc
RUN apk add --no-cache gcc musl-dev

ENV CGO_ENABLED=1

WORKDIR /go/src/github.com/gophish/gophish
COPY . .
# go-sqlite3 v2.0.3 fails to compile on musl (uses glibc-only off64_t);
# pin a fixed version for this build only (fixed upstream in v2.0.4+).
RUN go mod edit -replace github.com/mattn/go-sqlite3=github.com/mattn/go-sqlite3@v1.14.22 && \
	go mod tidy && \
	go mod download && go build -v


# Runtime container
FROM alpine:3.20

RUN adduser -D -h /opt/gophish -s /bin/sh app

RUN apk add --no-cache jq libcap ca-certificates bash

WORKDIR /opt/gophish
COPY --from=build-golang /go/src/github.com/gophish/gophish/ ./
COPY --from=build-js /build/static/js/dist/ ./static/js/dist/
COPY --from=build-js /build/static/css/dist/ ./static/css/dist/
COPY --from=build-golang /go/src/github.com/gophish/gophish/config.json ./
RUN chown app. config.json

RUN setcap 'cap_net_bind_service=+ep' /opt/gophish/gophish
RUN sed -i 's/\r$//' docker/run.sh && chmod 0755 docker/run.sh

# Create the data directory for the SQLite DB and hand it to the app user.
# Docker propagates this ownership to the named volume mounted at /data,
# so gophish (running as 'app') can create /data/gophish.db on first run
# and initialize a fresh database from the default migrations.
RUN mkdir -p /data && chown app:app /data

USER app
# Pre-create a writable config.json.tmp so run.sh (running as 'app') can
# rewrite config.json via jq at container start.
RUN touch config.json.tmp

EXPOSE 3333 8080 8443 80

CMD ["./docker/run.sh"]
